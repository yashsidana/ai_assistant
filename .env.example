# ==============================================================================
# AI Requirements Assistant - Environment Configuration
# ==============================================================================
# Choose your preferred LLM provider by providing the appropriate API key.
# The application automatically detects and uses the configured key.
# If no key is set, the application runs in offline demo / test mode.

# Option 1: Anthropic Claude (Recommended default)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-3-5-sonnet-20241022

# Option 2: OpenAI GPT-4o
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o

# Option 3: Google Gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-1.5-flash

